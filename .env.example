# Copy to .env.local for local development. NEVER commit the real file —
# .gitignore excludes *.local precisely so the key can't leak into the repo.

# K2 Aurora model endpoint. No VITE_ prefix on the key, deliberately: that keeps it
# server-side (the dev proxy in vite.config.js and server/prod.mjs attach it), so
# the browser never receives it.
K2_API_URL=http://<model-host>:<port>
K2_API_KEY=replace-me

# Local API port (dev only).
PD_API_PORT=5174

# Set to 1 when served over HTTPS so the login cookie is marked Secure.
# PD_HTTPS=1
